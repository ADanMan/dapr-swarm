# Copy to .env (ignored by Git), then fill in your own settings.
# No endpoint, model access, or API credential is bundled.
BEEGATE_BASE_URL=https://api.example.invalid/v1
BEEGATE_MODEL=your-glm-model-id
BEEGATE_API_KEY=
# Optional: a stable random secret. If empty, start.py generates one in memory.
SEARXNG_SECRET=
